@model List<RozgrywkaKoncowa.Controllers.StrategyEvalResult>
@{
    ViewBag.Title = "Ewaluacja strategii NS";
    var best = ViewBag.Best as RozgrywkaKoncowa.Controllers.StrategyEvalResult;
    int maxTricks = Model != null && Model.Any() ? Model[0].MaxTricks : 0;
    int targetTricks = ViewBag.TargetTricks != null ? (int)ViewBag.TargetTricks : maxTricks;
    string northStr = ViewBag.NorthStr ?? ViewBag.NorthCards ?? "";
    string southStr = ViewBag.SouthStr ?? ViewBag.SouthCards ?? "";
}
<h2>Ewaluacja strategii NS</h2>

<form method="get" asp-controller="StrategyEval" asp-action="Index" class="mb-4" id="evalForm" onsubmit="return validateForm()">
    <div class="mb-3" style="max-width: 400px;">
        <label class="form-label">Karty N (piki, np. AQT lub A10)</label>
        <input type="text" name="northCards" id="northCards" class="form-control" value="@ViewBag.NorthCards" 
               placeholder="np. AQT, AKJ, A10" />
        <div id="northError" class="text-danger small" style="display:none;"></div>
    </div>
    <div class="mb-3" style="max-width: 400px;">
        <label class="form-label">Karty S (piki, np. 234)</label>
        <input type="text" name="southCards" id="southCards" class="form-control" value="@ViewBag.SouthCards" 
               placeholder="np. 234, KQJ, 10987" />
        <div id="southError" class="text-danger small" style="display:none;"></div>
    </div>
    <div class="mb-3" style="max-width: 400px;">
        <label class="form-label">Oczekiwana liczba lew</label>
        <input type="number" name="targetTricks" id="targetTricks" class="form-control" 
               value="@ViewBag.TargetTricksInput" min="1" max="13" />
        <div id="targetError" class="text-danger small" style="display:none;"></div>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Oblicz</button>
        <span id="spinner" style="display:none; margin-left:10px">
            <span class="spinner-border spinner-border-sm" role="status"></span> Obliczam...
        </span>
    </div>
    <div id="formError" class="alert alert-danger" style="display:none;"></div>
</form>

<script>
function validateForm() {
    // Reset błędów
    document.getElementById('northError').style.display = 'none';
    document.getElementById('southError').style.display = 'none';
    document.getElementById('targetError').style.display = 'none';
    document.getElementById('formError').style.display = 'none';

    var north = document.getElementById('northCards').value.trim().toUpperCase();
    var south = document.getElementById('southCards').value.trim().toUpperCase();
    var target = parseInt(document.getElementById('targetTricks').value);

    var validRanks = ['A', 'K', 'Q', 'J', 'T', '9', '8', '7', '6', '5', '4', '3', '2'];
    var hasError = false;

    // Normalizuj "10" -> "T"
    north = north.replace(/10/g, 'T');
    south = south.replace(/10/g, 'T');

    // Parsuj karty North
    var northCards = parseCards(north);
    if (northCards === null) {
        document.getElementById('northError').innerText = 'Niepoprawne karty. Użyj: A, K, Q, J, T (lub 10), 9-2';
        document.getElementById('northError').style.display = 'block';
        hasError = true;
    } else if (northCards.length === 0) {
        document.getElementById('northError').innerText = 'Pole nie może być puste';
        document.getElementById('northError').style.display = 'block';
        hasError = true;
    } else if (hasDuplicates(northCards)) {
        document.getElementById('northError').innerText = 'Karty się powtarzają u North';
        document.getElementById('northError').style.display = 'block';
        hasError = true;
    }

    // Parsuj karty South
    var southCards = parseCards(south);
    if (southCards === null) {
        document.getElementById('southError').innerText = 'Niepoprawne karty. Użyj: A, K, Q, J, T (lub 10), 9-2';
        document.getElementById('southError').style.display = 'block';
        hasError = true;
    } else if (southCards.length === 0) {
        document.getElementById('southError').innerText = 'Pole nie może być puste';
        document.getElementById('southError').style.display = 'block';
        hasError = true;
    } else if (hasDuplicates(southCards)) {
        document.getElementById('southError').innerText = 'Karty się powtarzają u South';
        document.getElementById('southError').style.display = 'block';
        hasError = true;
    }

    // Sprawdź przecięcie NS
    if (northCards && southCards && !hasError) {
        var intersection = northCards.filter(c => southCards.includes(c));
        if (intersection.length > 0) {
            document.getElementById('formError').innerText = 'Karty powtarzają się między North i South: ' + intersection.join(', ');
            document.getElementById('formError').style.display = 'block';
            hasError = true;
        }
    }

    // Sprawdź liczbę lew
    if (isNaN(target) || target < 1) {
        document.getElementById('targetError').innerText = 'Wprowadź liczbę od 1 wzwyż';
        document.getElementById('targetError').style.display = 'block';
        hasError = true;
    }

    if (!hasError) {
        document.getElementById('spinner').style.display = 'inline';
    }

    return !hasError;
}

function parseCards(input) {
    if (!input) return [];
    var normalized = input.replace(/[,;]/g, ' ').trim();
    var validRanks = ['A', 'K', 'Q', 'J', 'T', '9', '8', '7', '6', '5', '4', '3', '2'];
    var cards = [];

    var tokens = normalized.split(/\s+/);
    for (var i = 0; i < tokens.length; i++) {
        var token = tokens[i];
        if (token.length === 1) {
            if (validRanks.includes(token)) {
                cards.push(token);
            } else {
                return null; // Niepoprawna karta
            }
        } else {
            // Ciąg znaków
            for (var j = 0; j < token.length; j++) {
                var ch = token[j];
                if (validRanks.includes(ch)) {
                    cards.push(ch);
                } else {
                    return null;
                }
            }
        }
    }
    return cards;
}

function hasDuplicates(arr) {
    return new Set(arr).size !== arr.length;
}
</script>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model != null && Model.Any())
{
    <p><b>Rozdanie:</b> N: @northStr &nbsp; S: @southStr &nbsp;&nbsp; <b>Kryterium sortowania:</b> największa szansa na wzięcie <b>co najmniej @targetTricks</b> lew.</p>
}

@if (best != null)
{
    <div style="background: #e0ffe0; padding: 10px; margin-bottom: 10px;">
        <b>Najlepsza strategia:</b> @best.Strategy<br />
        <b>Oczekiwana liczba lew:</b> @best.ExpectedTricks<br />
        <b>Szansa na co najmniej @targetTricks @(targetTricks == 1 ? "lewę" : "lewy"):</b> @best.GetProbabilityAtLeast(targetTricks).ToString("F6") %<br />
        @{
            double sumProb = 0;
        }
        @for (int k = maxTricks; k >= 0; k--)
        {
            var label = k == 1 ? "lewę" : "lewy";
            var val = best.PTricks[k];
            sumProb += val;
            <text><b>Szansa na dokładnie @k @label:</b> @val.ToString("F6") %<br /></text>
        }
        <text><i>(Suma kontrolna: @sumProb.ToString("F6") %)</i></text>
    </div>
}
@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
    <div style="margin-bottom: 24px; border: 1px solid #ccc; padding: 10px;">
        <h4>Strategia: <b>@item.Strategy</b></h4>
        <table class="table table-bordered table-sm" style="width:auto">
            <thead>
                <tr>
                    <th>EX (oczekiwana)</th>
                    <th style="background:#90ee90"><b>P(≥@targetTricks) (%)</b></th>
                    @for (int k = maxTricks; k >= 0; k--)
                    {
                        var label = k == 1 ? "lewę" : "lewy";
                        <th>P(=@k) (%)</th>
                    }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@item.ExpectedTricks</td>
                    <td style="background:#90ee90"><b>@item.GetProbabilityAtLeast(targetTricks).ToString("F6")</b></td>
                    @for (int k = maxTricks; k >= 0; k--)
                    {
                        <td>@item.PTricks[k].ToString("F6")</td>
                        }
                    }
                </tr>
            </tbody>
        </table>
        <details>
            <summary>Analiza rozkładów WE</summary>
            <table class="table table-bordered table-sm" style="width:auto; margin-top:6px">
                <thead>
                    <tr>
                        <th>W</th>
                        <th>E</th>
                        <th>Prawdop. (%)</th>
                        <th>Lewy NS</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in item.Details)
                {
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(d.WDist) ? "–" : d.WDist)</td>
                        <td>@(string.IsNullOrWhiteSpace(d.EDist) ? "–" : d.EDist)</td>
                        <td>@d.Probability.ToString("F6")</td>
                        <td>@d.NSTricks</td>
                    </tr>
                }
                </tbody>
            </table>
        </details>
    </div>
    }
}
else if (ViewBag.Error == null)
{
    <div>Brak danych do wyświetlenia.</div>
}
