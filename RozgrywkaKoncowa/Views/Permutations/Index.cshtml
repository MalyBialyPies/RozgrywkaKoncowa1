@model RozgrywkaKoncowa.Controllers.PermutationResultViewModel

@{
    ViewData["Title"] = "Wyniki permutacji";
}

<h1>Wyniki rozkładów (Minimaks)</h1>

<div class="mb-4">
    <h5>Ręka N: @Model.NHand</h5>
    <h5>Ręka S: @Model.SHand</h5>
</div>

<h3>Podsumowanie szans</h3>
<p class="text-muted">Prawdopodobieństwa uwzględniają brydżowy rozkład a priori podziałów kart obrony (wzór hipergeometryczny C(26-n, 13-k) / C(26,13)).</p>
<table class="table table-bordered table-sm w-auto mb-5">
    <thead class="table-dark">
        <tr>
            <th>Lewy NS</th>
            <th>Szansa (%)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model.Summary)
        {
            <tr>
                <td><strong>@s.NSWins</strong></td>
                <td>@s.WeightedProbability.ToString("F2") %</td>
            </tr>
        }
        <tr class="table-secondary">
            <td><strong>Suma</strong></td>
            <td><strong>@Model.Summary.Sum(s => s.WeightedProbability).ToString("F2") %</strong></td>
        </tr>
    </tbody>
</table>

<h3>Szczegółowe wyniki dla każdego podziału</h3>
<table class="table table-bordered table-striped table-sm">
    <thead>
        <tr>
            <th>Ręka W</th>
            <th>Ręka E</th>
            <th>Minimaks (lewy NS)</th>
            <th>Prawdopodobieństwo (%)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.WHand</td>
                <td>@item.EHand</td>
                <td>@item.NSWins</td>
                <td>@((item.Probability * 100m).ToString("F4")) %</td>
            </tr>
        }
    </tbody>
</table>
