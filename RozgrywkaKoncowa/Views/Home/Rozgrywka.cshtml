@model RozgrywkaKoncowa.Models.CBoard

@{
    ViewData["Title"] = "Rozgrywka";
    // Sortowanie i rysowanie jak w GeneracjaRozdania
    List<RozgrywkaKoncowa.Models.CCard> SortHand(RozgrywkaKoncowa.Models.CHand hand)
        => hand.OrderByDescending(c => c.Denomination.Value).ThenByDescending(c => c.Rank.Value).ToList();
    string DrawHand(RozgrywkaKoncowa.Models.CHand hand)
    {
        var denomOrder = RozgrywkaKoncowa.Models.CDenomination.All
            .Where(d => d.Value > 0 && d != RozgrywkaKoncowa.Models.CDenomination.NT)
            .OrderByDescending(d => d.Value)
            .ToArray();
        var sb = new System.Text.StringBuilder();
        foreach (var denom in denomOrder)
        {
            var cards = hand.Where(c => c.Denomination == denom)
                            .OrderByDescending(c => c.Rank.Value)
                            .ToList();
            string color = denom.Color;
            string ranks = cards.Count > 0
                ? string.Join("", cards.Select(c => c.Rank.Symbol))
                : "—";
            sb.Append($"<div><span style='color:{color};font-weight:bold;margin-right:4px;'>{denom.Symbol}</span>");
            sb.Append($"<span>{ranks}</span></div>");
        }
        return sb.ToString();
    }
}

<style>
    .board-cross {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        grid-template-rows: auto auto auto;
        gap: 0;
        width: fit-content;
        margin: 0 auto;
        font-family: monospace;
        font-size: 1rem;
    }
    .board-cell {
        border: 1px solid #aaa;
        padding: 12px 18px;
        min-width: 200px;
        background: #fafafa;
    }
    .board-cell-center {
        border: 1px solid #aaa;
        padding: 12px 18px;
        background: #f0f0e0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-width: 120px;
        font-size: 0.9rem;
    }
    .board-cell-empty {
        background: transparent;
        border: none;
    }
    .compass {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        grid-template-rows: 1fr 1fr 1fr;
        text-align: center;
        font-weight: bold;
        font-size: 1rem;
        width: 60px;
        margin: 0 auto 4px auto;
    }
    .compass-n { grid-column: 2; grid-row: 1; }
    .compass-w { grid-column: 1; grid-row: 2; }
    .compass-e { grid-column: 3; grid-row: 2; }
    .compass-s { grid-column: 2; grid-row: 3; }
    .suit-row {
        line-height: 1.7;
    }
</style>

<h2>@ViewData["Title"]</h2>

<div class="contract-info mb-3">
    <div><strong>Kontrakt:</strong> @Html.Raw($"{Model.Contract.Level}<span style='color:{Model.Contract.Denomination.Color};font-weight:bold;'>{Model.Contract.Denomination.Symbol}</span>{(Model.Contract.Double == RozgrywkaKoncowa.Models.CDouble.Pass ? "" : Model.Contract.Double.Symbol)}")</div>
    <div><strong>Rozgrywaj&#x105;cy:</strong> @Model.Declarer.Symbol</div>
</div>

<div class="board-cross mt-4">
    @*Row 1: North*@
    <div class="contract-info"></div>
    <div class="board-cell">
        <div class="suit-row">@Html.Raw(DrawHand(Model.Hands[0]))</div>
    </div>
    <div class="board-cell-empty"></div>

    @*Row 2: West | Center | East*@
    <div class="board-cell">
        <div class="suit-row">@Html.Raw(DrawHand(Model.Hands[3]))</div>
    </div>
    <div class="board-cell-center">
        <div class="compass">
            <span class="compass-n">@RozgrywkaKoncowa.Models.CPlayer.PlayerNorth.Symbol</span>
            <span class="compass-w">@RozgrywkaKoncowa.Models.CPlayer.PlayerWest.Symbol</span>
            <span class="compass-e">@RozgrywkaKoncowa.Models.CPlayer.PlayerEast.Symbol</span>
            <span class="compass-s">@RozgrywkaKoncowa.Models.CPlayer.PlayerSouth.Symbol</span>
        </div>
    </div>
    <div class="board-cell">
        <div class="suit-row">@Html.Raw(DrawHand(Model.Hands[1]))</div>
    </div>

    @*Row 3: South*@
    <div class="board-cell-empty"></div>
    <div class="board-cell">
        <div class="suit-row">@Html.Raw(DrawHand(Model.Hands[2]))</div>
    </div>
    <div class="board-cell-empty"></div>
</div>
